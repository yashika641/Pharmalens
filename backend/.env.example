# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ── Gemini (Google AI Studio) ─────────────────────────────────────────────────
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── Google Translate API ──────────────────────────────────────────────────────
# Same Google Cloud API key works if Translate API is enabled on the project
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key

# ── OCR.Space (free tier available) ──────────────────────────────────────────
# Get key from: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=your_ocr_space_key

# ── Local paths (adjust for your OS) ─────────────────────────────────────────
# Linux/Mac:
# FAISS_INDEX_PATH=./backend/models/chatbot/faiss_compressed.index
# CHUNKS_PARQUET_PATH=./backend/chunks.parquet
# Windows:
FAISS_INDEX_PATH=C:\path\to\Pharmalens\backend\models\chatbot\faiss_compressed.index
CHUNKS_PARQUET_PATH=C:\path\to\Pharmalens\backend\chunks.parquet

# ── API URL (for local dev) ───────────────────────────────────────────────────
API_URL=http://localhost:8000
