<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#0a0e1a</item>
        <item name="colorPrimaryDark">#0a0e1a</item>
        <item name="colorAccent">#2DD4BF</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Transparent status bar so the web layer controls it via env(safe-area-inset-top) -->
        <item name="android:statusBarColor">#0a0e1a</item>
        <item name="android:windowTranslucentStatus">false</item>
        <!-- Allow content to flow into the display cutout (punch-hole camera) area -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Light/dark status bar icon tint — use dark icons on light bg, light on dark bg -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

</resources>
